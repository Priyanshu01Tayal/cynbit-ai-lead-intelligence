# Cynbit AI – Lead Qualification & Automation Agent Configuration

# Application Settings
APP_NAME="Cynbit AI Lead Intelligence"
ENVIRONMENT="development"
DEBUG=True
API_HOST="127.0.0.1"
API_PORT=8000
FRONTEND_PORT=8501

# Database Configuration
DATABASE_URL="sqlite:///./data/cynbit_leads.db"

# ML Model Paths
ML_MODEL_PATH="./models/lead_classifier.joblib"
ML_VECTORIZER_PATH="./models/tfidf_vectorizer.joblib"
ML_METRICS_PATH="./models/model_metrics.json"

# LLM API Configuration (Optional)
# Leave blank to use high-quality heuristic & template-based response engine
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="template"

# Lead Scoring Weights (Must sum to 1.0 or normalized)
WEIGHT_BUDGET=0.30
WEIGHT_URGENCY=0.25
WEIGHT_REQUIREMENTS=0.20
WEIGHT_TIMELINE=0.15
WEIGHT_RELEVANCE=0.10
